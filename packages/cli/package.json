{
  "name": "@abjad-org/research-chef",
  "version": "0.1.2",
  "description": "research-chef: an interactive, BYOK-powered AI research assistant for your terminal",
  "type": "module",
  "bin": {
    "research-chef": "bin/research-chef.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node bin/research-chef.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "license": "MIT",
  "keywords": [
    "cli",
    "ai",
    "research",
    "byok",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "terminal",
    "clack"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abjad-org/research-chef.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/abjad-org/research-chef/issues"
  },
  "homepage": "https://github.com/abjad-org/research-chef#readme"
}
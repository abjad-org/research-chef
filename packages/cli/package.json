{
  "name": "@research-chef/cli",
  "version": "0.1.0",
  "description": "research-chef: an interactive, BYOK-powered AI research assistant for your terminal",
  "type": "module",
  "bin": {
    "research-chef": "./bin/research-chef.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node bin/research-chef.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "license": "MIT"
}
